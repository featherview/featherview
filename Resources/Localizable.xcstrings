    "Save As and the batch window start with these options for each format." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبدأ «حفظ باسم» ونافذة الدفعة بهذه الخيارات لكل تنسيق."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desa com a i la finestra de lots comencen amb aquestes opcions per a cada format."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uložit jako a okno dávky začínají s těmito volbami pro každý formát."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gem som og batchvinduet starter med disse indstillinger for hvert format."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Speichern unter“ und das Stapelfenster beginnen mit diesen Optionen für jedes Format."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η «Αποθήκευση ως» και το παράθυρο μαζικής επεξεργασίας ξεκινούν με αυτές τις επιλογές για κάθε μορφή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardar como y la ventana de lotes empiezan con estas opciones para cada formato."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallenna nimellä ja eräkäsittelyikkuna käyttävät aluksi näitä valintoja kullekin muodolle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Enregistrer sous » et la fenêtre de traitement par lot partent de ces options pour chaque format."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "״שמור בשם״ וחלון האצווה מתחילים עם האפשרויות האלה לכל פורמט."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“इस रूप में सहेजें” और बैच विंडो हर फ़ॉर्मैट के लिए इन्हीं विकल्पों से शुरू होते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Mentés másként és a kötegelt ablak ezekkel a beállításokkal indul az egyes formátumokhoz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simpan Sebagai dan jendela batch dimulai dengan pilihan ini untuk setiap format."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva come e la finestra batch partono da queste opzioni per ogni formato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“別名で保存”と一括処理ウインドウは、各フォーマットをこのオプションで開始します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'다른 이름으로 저장'과 일괄 처리 윈도우는 각 포맷을 이 옵션으로 시작합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simpan Sebagai dan tetingkap kelompok bermula dengan pilihan ini bagi setiap format."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewaar als en het batchvenster beginnen met deze opties voor elk formaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zachowaj jako i okno przetwarzania wsadowego zaczynają z tymi opcjami dla każdego formatu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvar Como e a janela de lote começam com estas opções para cada formato."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvează ca și fereastra de lot pornesc cu aceste opțiuni pentru fiecare format."
