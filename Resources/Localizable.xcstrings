    "Featherview can open your images instead of Preview. You can change this later in Preferences › Browsing.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Featherview kan je afbeeldingen openen in plaats van Voorvertoning. Je kunt dit later wijzigen in Voorkeuren › Bladeren."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Featherview kan öppna dina bilder i stället för Förhandsvisning. Du kan ändra det senare i Inställningar › Bläddring."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Featherview kan åbne dine billeder i stedet for Eksempel. Du kan ændre det senere i Indstillinger › Gennemsyn."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Featherview voi avata kuvasi Esikatselun sijaan. Voit muuttaa tätä myöhemmin kohdassa Asetukset › Selaus."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El Featherview pot obrir les teves imatges en lloc de la Previsualització. Ho pots canviar més tard a Preferències › Navegació."
          }
        }
      }
    },
    "Featherview couldn't become the default for %@.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Featherview kon niet de standaardapp voor %@ worden."
