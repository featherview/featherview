    "Featherview can open them instead of Preview. Other image types can follow in Settings › Browsing." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن لـ Featherview فتحها بدلًا من «معاينة». يمكنك إضافة أنواع صور أخرى في الإعدادات › التصفح."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Featherview les pot obrir en lloc de la Previsualització. Pots afegir altres tipus d’imatge a Configuració › Navegació."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Featherview je může otevírat místo Náhledu. Další typy obrázků můžete přidat v Nastavení › Procházení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Featherview kan åbne dem i stedet for Eksempel. Andre billedtyper kan du tilføje i Indstillinger › Gennemsyn."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Featherview kann sie statt Vorschau öffnen. Weitere Bildtypen kannst du unter Einstellungen › Blättern hinzufügen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Featherview μπορεί να τις ανοίγει αντί για την Προεπισκόπηση. Μπορείτε να προσθέσετε κι άλλους τύπους εικόνων στις Ρυθμίσεις › Περιήγηση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Featherview puede abrirlas en lugar de Vista Previa. Puedes añadir otros tipos de imagen en Ajustes › Navegación."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Featherview voi avata ne Esikatselun sijaan. Voit lisätä muita kuvatyyppejä kohdassa Asetukset › Selaus."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Featherview peut les ouvrir à la place d’Aperçu. Vous pourrez ajouter d’autres types d’images dans Réglages › Navigation."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Featherview יכול לפתוח אותן במקום ״תצוגה מקדימה״. ניתן להוסיף סוגי תמונות נוספים בהגדרות › דפדוף."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Featherview उन्हें Preview की जगह खोल सकता है। अन्य छवि प्रकार आप सेटिंग्ज़ › ब्राउज़िंग में जोड़ सकते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Featherview az Előnézet helyett is megnyithatja őket. További képtípusokat a Beállítások › Böngészés részen adhat hozzá."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Featherview dapat membukanya sebagai pengganti Pratinjau. Anda dapat menambahkan jenis gambar lain di Pengaturan › Penjelajahan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Featherview può aprirle al posto di Anteprima. Puoi aggiungere altri tipi di immagine in Impostazioni › Navigazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プレビューの代わりに Featherview で開けます。ほかの画像の種類は“設定 › ブラウズ”で追加できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "미리보기 대신 Featherview로 열 수 있습니다. 다른 이미지 유형은 설정 › 탐색에서 추가할 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Featherview boleh membukanya dan bukannya Pratonton. Anda boleh menambah jenis imej lain dalam Seting › Penyemakan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Featherview kan ze openen in plaats van Voorvertoning. Andere afbeeldingstypen kun je toevoegen in Instellingen › Bladeren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Featherview może je otwierać zamiast Podglądu. Inne typy obrazków możesz dodać w Ustawienia › Przeglądanie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Featherview pode abri-las em vez do Pré-Visualização. Você pode adicionar outros tipos de imagem em Ajustes › Navegação."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Featherview le poate deschide în locul aplicației Previzualizare. Poți adăuga alte tipuri de imagini în Configurări › Navigare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Featherview может открывать их вместо Просмотра. Другие типы изображений можно добавить в разделе Настройки › Навигация."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Featherview kan öppna dem i stället för Förhandsvisning. Andra bildtyper kan du lägga till i Inställningar › Bläddring."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Featherview สามารถเปิดภาพเหล่านั้นแทนแอปแสดงตัวอย่างได้ คุณเพิ่มภาพประเภทอื่นได้ในการตั้งค่า › การเรียกดู"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Featherview bunları Önizleme yerine açabilir. Diğer görüntü türlerini Ayarlar › Göz Atma bölümünden ekleyebilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Featherview може відкривати їх замість Перегляду. Інші типи зображень можна додати в Параметри › Навігація."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Featherview có thể mở chúng thay cho Xem trước. Bạn có thể thêm các loại ảnh khác trong Cài đặt › Duyệt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Featherview 可以代替“预览”打开它们。你可以在“设置 › 浏览”中添加其他图像类型。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Featherview 可以取代「預覽程式」打開它們。你可以在「設定 › 瀏覽」中加入其他影像類型。"
          }
        }
      }
    },
