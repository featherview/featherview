    "The date taken can be changed in JPEG, HEIC, TIFF and PSD files only": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Aufnahmedatum lässt sich nur in JPEG-, HEIC-, TIFF- und PSD-Dateien ändern"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La date de prise de vue ne peut être modifiée que dans les fichiers JPEG, HEIC, TIFF et PSD"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La fecha de captura solo se puede cambiar en archivos JPEG, HEIC, TIFF y PSD"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La data di scatto si può modificare solo nei file JPEG, HEIC, TIFF e PSD"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A data de captura só pode ser alterada em arquivos JPEG, HEIC, TIFF e PSD"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De opnamedatum kan alleen in JPEG-, HEIC-, TIFF- en PSD-bestanden worden gewijzigd"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagningsdatumet kan bara ändras i JPEG-, HEIC-, TIFF- och PSD-filer"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Optagelsesdatoen kan kun ændres i JPEG-, HEIC-, TIFF- og PSD-filer"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvauspäivää voi muuttaa vain JPEG-, HEIC-, TIFF- ja PSD-tiedostoissa"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La data de captura només es pot canviar en fitxers JPEG, HEIC, TIFF i PSD"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дату съёмки можно изменить только в файлах JPEG, HEIC, TIFF и PSD"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дату зйомки можна змінити лише у файлах JPEG, HEIC, TIFF і PSD"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Datę wykonania można zmienić tylko w plikach JPEG, HEIC, TIFF i PSD"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Datum pořízení lze změnit jen v souborech JPEG, HEIC, TIFF a PSD"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ημερομηνία λήψης αλλάζει μόνο σε αρχεία JPEG, HEIC, TIFF και PSD"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن تغيير تاريخ الالتقاط في ملفات JPEG وHEIC وTIFF وPSD فقط"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר לשנות את תאריך הצילום בקובצי JPEG,‏ HEIC,‏ TIFF ו־PSD בלבד"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çekim tarihi yalnızca JPEG, HEIC, TIFF ve PSD dosyalarında değiştirilebilir"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A készítési dátum csak JPEG, HEIC, TIFF és PSD fájlokban módosítható"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Data fotografierii poate fi schimbată doar în fișierele JPEG, HEIC, TIFF și PSD"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅可更改 JPEG、HEIC、TIFF 和 PSD 文件的拍摄时间"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅可更改 JPEG、HEIC、TIFF 和 PSD 檔案的拍攝日期"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "撮影日時を変更できるのは JPEG、HEIC、TIFF、PSD ファイルのみです"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "촬영일은 JPEG, HEIC, TIFF 및 PSD 파일에서만 변경할 수 있습니다"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लेने की तिथि केवल JPEG, HEIC, TIFF और PSD फ़ाइलों में बदली जा सकती है"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปลี่ยนวันที่ถ่ายได้เฉพาะในไฟล์ JPEG, HEIC, TIFF และ PSD เท่านั้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ có thể thay đổi ngày chụp trong tệp JPEG, HEIC, TIFF và PSD"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanggal diambil hanya dapat diubah pada file JPEG, HEIC, TIFF, dan PSD"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarikh diambil hanya boleh ditukar dalam fail JPEG, HEIC, TIFF dan PSD"
          }
        }
      }
    },
