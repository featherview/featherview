    "Higher is slower and makes smaller files": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Höher ist langsamer und erzeugt kleinere Dateien"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus élevé, c’est plus lent et les fichiers sont plus petits"
