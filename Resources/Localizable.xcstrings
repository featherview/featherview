    "A name can't contain “/” or “:”.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن أن يحتوي الاسم على «/» أو «:»."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nom no pot contenir «/» ni «:»."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Název nemůže obsahovat „/“ ani „:“."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et navn kan ikke indeholde “/” eller “:”."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Name darf weder „/“ noch „:“ enthalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα όνομα δεν μπορεί να περιέχει «/» ή «:»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nombre no puede contener «/» ni «:»."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimessä ei voi olla merkkiä ”/” tai ”:”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nom ne peut pas contenir « / » ni « : »."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שם אינו יכול להכיל “/” או “:”."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नाम में “/” या “:” नहीं हो सकता।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A név nem tartalmazhat „/” vagy „:” karaktert."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama tidak boleh berisi “/” atau “:”."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nome non può contenere “/” o “:”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前に“/”や“:”は使用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름에 ‘/’ 또는 ‘:’을 포함할 수 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama tidak boleh mengandungi “/” atau “:”."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een naam mag geen ‘/’ of ‘:’ bevatten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nazwa nie może zawierać „/” ani „:”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um nome não pode conter “/” ou “:”."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nume nu poate conține „/” sau „:”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имя не может содержать «/» или «:»."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett namn kan inte innehålla ”/” eller ”:”."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชื่อต้องไม่มี “/” หรือ “:”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir ad “/” veya “:” içeremez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Назва не може містити «/» або «:»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tên không được chứa “/” hoặc “:”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名称不能包含“/”或“:”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "名稱不能包含「/」或「:」。"
          }
        }
      }
    },
    "A name can't start with “.”: the file would be hidden.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن أن يبدأ الاسم بـ «.»: سيصبح الملف مخفيًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nom no pot començar amb «.»: el fitxer quedaria ocult."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Název nemůže začínat „.“: soubor by byl skrytý."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et navn kan ikke starte med “.”: arkivet ville blive skjult."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Name darf nicht mit „.“ beginnen: Die Datei wäre unsichtbar."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα όνομα δεν μπορεί να ξεκινά με «.»: το αρχείο θα ήταν κρυφό."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nombre no puede empezar por «.»: el archivo quedaría oculto."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimi ei voi alkaa merkillä ”.”: tiedosto olisi kätketty."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nom ne peut pas commencer par « . » : le fichier serait masqué."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שם אינו יכול להתחיל ב־“.”: הקובץ יוסתר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नाम “.” से शुरू नहीं हो सकता: फ़ाइल छिप जाएगी।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A név nem kezdődhet „.” karakterrel: a fájl rejtett lenne."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama tidak boleh diawali “.”: file akan tersembunyi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nome non può iniziare con “.”: il file sarebbe nascosto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前を“.”で始めることはできません。ファイルが非表示になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름은 ‘.’으로 시작할 수 없습니다. 파일이 가려집니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama tidak boleh bermula dengan “.”: fail akan tersembunyi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een naam mag niet met ‘.’ beginnen: het bestand zou verborgen zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nazwa nie może zaczynać się od „.”: plik byłby ukryty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um nome não pode começar com “.”: o arquivo ficaria oculto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nume nu poate începe cu „.”: fișierul ar fi ascuns."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имя не может начинаться с «.»: файл станет скрытым."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett namn kan inte börja med ”.”: filen skulle bli dold."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชื่อต้องไม่ขึ้นต้นด้วย “.” เพราะไฟล์จะถูกซ่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir ad “.” ile başlayamaz: dosya gizli olur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Назва не може починатися з «.»: файл стане прихованим."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tên không được bắt đầu bằng “.”: tệp sẽ bị ẩn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名称不能以“.”开头：文件将被隐藏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "名稱不能以「.」開頭：檔案將被隱藏。"
          }
        }
      }
    },
