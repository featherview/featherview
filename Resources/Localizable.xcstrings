    "The image may then open in another app, or not at all.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Bild öffnet sich dann vielleicht in einer anderen App oder gar nicht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’image risque alors de s’ouvrir dans une autre app, voire de ne plus s’ouvrir."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es posible que la imagen se abra entonces en otra app o que no se abra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’immagine potrebbe aprirsi in un’altra app o non aprirsi affatto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A imagem poderá abrir em outro app ou simplesmente não abrir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изображение может открываться в другом приложении или не открываться вовсе."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зображення може відкриватися в іншій програмі або не відкриватися взагалі."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obraz może wtedy otwierać się w innej aplikacji albo wcale."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrázek se pak může otevírat v jiné aplikaci, nebo vůbec."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η εικόνα μπορεί τότε να ανοίγει σε άλλη εφαρμογή ή να μην ανοίγει καθόλου."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد تُفتح الصورة حينها في تطبيق آخر أو لا تُفتح إطلاقًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ייתכן שהתמונה תיפתח אז ביישום אחר, או שלא תיפתח בכלל."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görüntü bu durumda başka bir uygulamada açılabilir veya hiç açılmayabilir."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kép ezután egy másik appban nyílhat meg, vagy egyáltalán nem."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Imaginea s-ar putea deschide apoi în altă aplicație sau deloc."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "イメージがほかのアプリで開かれたり、開けなくなったりする可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지가 다른 앱에서 열리거나 아예 열리지 않을 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图像随后可能会在其他 App 中打开,或者根本无法打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "影像之後可能會在其他 App 中打開,或完全無法打開。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तब छवि किसी दूसरे ऐप में खुल सकती है, या बिल्कुल नहीं खुल सकती।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ภาพอาจเปิดในแอปอื่น หรือเปิดไม่ได้เลย"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi đó, hình ảnh có thể mở trong một ứng dụng khác hoặc không mở được."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gambar mungkin akan terbuka di app lain, atau tidak terbuka sama sekali."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Imej mungkin dibuka dalam app lain, atau tidak dibuka langsung."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Llavors la imatge es podria obrir amb una altra app o no obrir-se."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
