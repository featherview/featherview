    "Its settings are lost.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Einstellungen gehen verloren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses réglages seront perdus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus ajustes se perderán."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sue impostazioni andranno perse."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os ajustes dela serão perdidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Его настройки будут потеряны."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Його налаштування буде втрачено."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jego ustawienia zostaną utracone."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Její nastavení se ztratí."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι ρυθμίσεις της θα χαθούν."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستُفقد إعداداته."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההגדרות שלה יאבדו."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarları kaybolur."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A beállításai elvesznek."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurările ei se pierd."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定は失われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 설정은 사라집니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其设置将会丢失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其設定將會遺失。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसकी सेटिंग्ज़ खो जाएँगी।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การตั้งค่าของพรีเซ็ตนี้จะหายไป"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các cài đặt của nó sẽ mất."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengaturannya akan hilang."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setingnya akan hilang."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Se’n perdrà la configuració."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dens indstillinger går tabt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sen asetukset menetetään."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De instellingen ervan gaan verloren."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dess inställningar går förlorade."
          }
        }
      }
    },
