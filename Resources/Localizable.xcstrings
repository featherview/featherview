    "Always Open .%@ Files with Featherview": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فتح ملفات ‎.%@ دائمًا باستخدام Featherview"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Obre sempre els fitxers .%@ amb el Featherview"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vždy otevírat soubory .%@ ve Featherview"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn altid .%@-filer med Featherview"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": ".%@-Dateien immer mit Featherview öffnen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάντα άνοιγμα των αρχείων .%@ με το Featherview"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir siempre los archivos .%@ con Featherview"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa .%@-tiedostot aina Featherview-apilla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toujours ouvrir les fichiers .%@ avec Featherview"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתח תמיד קובצי ‎.%@ באמצעות Featherview"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ".%@ फ़ाइलें हमेशा Featherview से खोलें"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) .%@ fájlok megnyitása mindig a Featherview-val"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selalu Buka File .%@ dengan Featherview"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri sempre i file .%@ con Featherview"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": ".%@ ファイルを常に Featherview で開く"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ".%@ 파일을 항상 Featherview로 열기"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentiasa Buka Fail .%@ dengan Featherview"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": ".%@-bestanden altijd openen met Featherview"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zawsze otwieraj pliki .%@ w Featherview"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sempre Abrir Arquivos .%@ com o Featherview"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschide întotdeauna fișierele .%@ cu Featherview"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всегда открывать файлы .%@ в Featherview"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna alltid .%@-filer med Featherview"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดไฟล์ .%@ ด้วย Featherview เสมอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ".%@ Dosyalarını Her Zaman Featherview ile Aç"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завжди відкривати файли .%@ у Featherview"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luôn mở tệp .%@ bằng Featherview"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "始终用 Featherview 打开 .%@ 文件"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一律使用 Featherview 打開 .%@ 檔案"
          }
        }
      }
    },
