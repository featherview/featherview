    "Quit while the batch is running?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beenden, während der Stapel läuft?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitter pendant le traitement du lot ?"
          }
