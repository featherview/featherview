    "Don't enlarge smaller images": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleinere Bilder nicht vergrößern"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne pas agrandir les images plus petites"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No ampliar imágenes más pequeñas"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ingrandire le immagini più piccole"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não ampliar imagens menores"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не увеличивать маленькие изображения"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не збільшувати менші зображення"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie powiększaj mniejszych obrazków"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nezvětšovat menší obrázky"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χωρίς μεγέθυνση μικρότερων εικόνων"
