        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při prohlížení skrývat nástrojový panel a stavový řádek"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απόκρυψη γραμμής εργαλείων και γραμμής κατάστασης κατά την προβολή"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إخفاء شريط الأدوات وشريط الحالة أثناء العرض"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הסתר את סרגל הכלים ואת שורת המצב בזמן הצפייה"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görüntülerken araç çubuğunu ve durum çubuğunu gizle"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Eszközsor és állapotsor elrejtése nézegetés közben"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ascunde bara de instrumente și bara de stare în timpul vizualizării"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示中はツールバーとステータスバーを隠す"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보는 동안 도구 막대 및 상태 막대 가리기"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看时隐藏工具栏和状态栏"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢視時隱藏工具列和狀態列"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "देखते समय टूलबार और स्टेटस बार छिपाएँ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ซ่อนแถบเครื่องมือและแถบสถานะขณะดู"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ẩn thanh công cụ và thanh trạng thái khi xem"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sembunyikan bar alat dan bar status saat melihat"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sembunyikan bar alat dan bar status semasa melihat"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta la barra d’eines i la d’estat mentre es miren imatges"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjul værktøjslinje og statuslinje under visning"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kätke työkalupalkki ja tilapalkki katselun ajaksi"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verberg knoppenbalk en statusbalk tijdens het bekijken"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Göm verktygsfältet och statusfältet vid visning"
          }
        }
      }
    },
    "Higher is slower and makes smaller files": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Höher ist langsamer und erzeugt kleinere Dateien"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus élevé, c’est plus lent et les fichiers sont plus petits"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más alto es más lento y crea archivos más pequeños"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Più alto è più lento e crea file più piccoli"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais alto é mais lento e gera arquivos menores"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чем выше, тем медленнее и тем меньше файлы"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Що вище, то повільніше і менші файли"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyżej to wolniej, ale mniejsze pliki"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyšší je pomalejší a dává menší soubory"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Υψηλότερη τιμή: πιο αργά και μικρότερα αρχεία"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "القيمة الأعلى أبطأ وتنتج ملفات أصغر"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ערך גבוה יותר איטי יותר ויוצר קבצים קטנים יותר"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha yüksek değer daha yavaştır ve daha küçük dosyalar üretir"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A magasabb érték lassabb, és kisebb fájlokat készít"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O valoare mai mare e mai lentă și produce fișiere mai mici"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高いほど遅くなり、ファイルは小さくなります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "높을수록 느리지만 파일이 작아집니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "越高越慢，文件越小"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "越高越慢，檔案越小"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अधिक होने पर धीमा, पर फ़ाइलें छोटी"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค่าสูงจะช้ากว่าแต่ได้ไฟล์เล็กกว่า"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Càng cao càng chậm nhưng tệp càng nhỏ"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lebih tinggi lebih lambat, file lebih kecil"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lebih tinggi lebih perlahan, fail lebih kecil"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Més alt és més lent i fa fitxers més petits"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Højere er langsommere og giver mindre filer"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suurempi on hitaampi ja tekee pienempiä tiedostoja"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoger is trager en geeft kleinere bestanden"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Högre är långsammare och ger mindre filer"
          }
        }
      }
    },
