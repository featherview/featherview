    "{folder} in the path stands for each image's folder name.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "{folder} im Pfad steht für den Ordnernamen jedes Bildes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "{folder} dans le chemin représente le nom du dossier de chaque image."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "{folder} en la ruta representa el nombre de la carpeta de cada imagen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "{folder} nel percorso indica il nome della cartella di ogni immagine."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "{folder} no caminho representa o nome da pasta de cada imagem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "{folder} в пути заменяется именем папки каждого изображения."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "{folder} у шляху замінюється назвою папки кожного зображення."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "{folder} w ścieżce oznacza nazwę folderu każdego obrazka."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "{folder} v cestě znamená název složky každého obrázku."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το {folder} στη διαδρομή αντιστοιχεί στο όνομα του φακέλου κάθε εικόνας."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "{folder} في المسار يعني اسم مجلد كل صورة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "{folder} בנתיב מייצג את שם התיקייה של כל תמונה."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yoldaki {folder}, her görüntünün klasör adı anlamına gelir."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A {folder} az útvonalban az egyes képek mappájának nevét jelenti."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "{folder} în cale înseamnă numele dosarului fiecărei imagini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パス内の {folder} は各画像のフォルダ名を表します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "경로의 {folder}는 각 이미지의 폴더 이름을 나타냅니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
