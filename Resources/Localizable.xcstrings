          "stringUnit": {
            "state": "translated",
            "value": "عدم تكبير الصور الأصغر"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אל תגדיל תמונות קטנות יותר"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha küçük görüntüleri büyütme"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kisebb képek ne legyenek nagyítva"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu mări imaginile mai mici"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "小さい画像は拡大しない"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작은 이미지는 확대하지 않음"
          }
