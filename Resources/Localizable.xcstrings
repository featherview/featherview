    "Each frame of an animation and each page of a document becomes its own file." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يصبح كل إطار من الرسوم المتحركة وكل صفحة من المستند ملفًا مستقلًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada fotograma d’una animació i cada pàgina d’un document esdevé un fitxer propi."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každý snímek animace a každá stránka dokumentu se stane samostatným souborem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvert billede i en animation og hver side i et dokument bliver sin egen fil."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Bild einer Animation und jede Seite eines Dokuments wird eine eigene Datei."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάθε καρέ μιας κινούμενης εικόνας και κάθε σελίδα ενός εγγράφου γίνεται ξεχωριστό αρχείο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada fotograma de una animación y cada página de un documento se convierte en su propio archivo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Animaation jokaisesta kehyksestä ja asiakirjan jokaisesta sivusta tulee oma tiedostonsa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque image d’une animation et chaque page d’un document devient un fichier distinct."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כל פריים של הנפשה וכל עמוד של מסמך הופכים לקובץ נפרד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एनिमेशन का हर फ़्रेम और दस्तावेज़ का हर पेज अपनी अलग फ़ाइल बन जाता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az animáció minden képkockája és a dokumentum minden oldala külön fájl lesz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setiap bingkai animasi dan setiap halaman dokumen menjadi file tersendiri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni fotogramma di un’animazione e ogni pagina di un documento diventa un file a sé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アニメーションの各フレームと書類の各ページがそれぞれ別のファイルになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "애니메이션의 각 프레임과 문서의 각 페이지가 별도의 파일이 됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setiap bingkai animasi dan setiap halaman dokumen menjadi fail tersendiri."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elk frame van een animatie en elke pagina van een document wordt een eigen bestand."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każda klatka animacji i każda strona dokumentu staje się osobnym plikiem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada quadro de uma animação e cada página de um documento vira um arquivo próprio."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiecare cadru al unei animații și fiecare pagină a unui document devine un fișier separat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый кадр анимации и каждая страница документа становятся отдельным файлом."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje bildruta i en animering och varje sida i ett dokument blir en egen fil."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แต่ละเฟรมของภาพเคลื่อนไหวและแต่ละหน้าของเอกสารจะกลายเป็นไฟล์แยกของตัวเอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir animasyonun her karesi ve bir belgenin her sayfası ayrı bir dosya olur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кожен кадр анімації та кожна сторінка документа стають окремим файлом."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mỗi khung hình của ảnh động và mỗi trang của tài liệu trở thành một tệp riêng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "动画的每一帧和文稿的每一页都会成为单独的文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "動畫的每一格和文件的每一頁都會成為獨立的檔案。"
          }
        }
      }
