    "The canvas settings leave no image": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Leinwand-Einstellungen lassen kein Bild übrig"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réglages du canevas ne laissent aucune image"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ajustes del lienzo no dejan imagen"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le impostazioni della tela non lasciano alcuna immagine"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os ajustes da tela não deixam imagem"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При этих настройках холста от изображения ничего не остаётся"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За цих налаштувань полотна від зображення нічого не лишається"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przy tych ustawieniach płótna z obrazka nic nie zostaje"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při tomto nastavení plátna z obrázku nic nezbude"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Με αυτές τις ρυθμίσεις καμβά δεν μένει τίποτα από την εικόνα"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعدادات اللوحة لا تُبقي شيئًا من الصورة"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגדרות המשטח לא משאירות דבר מהתמונה"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuval ayarları görüntüden bir şey bırakmıyor"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A vászon beállításai nem hagynak semmit a képből"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurările pânzei nu lasă nimic din imagine"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンバス設定によって画像がすべて切り取られます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캔버스 설정 때문에 이미지가 모두 잘립니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "画布设置会裁掉整张图像"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "畫布設定會裁掉整張影像"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैनवास सेटिंग्ज़ से कोई छवि नहीं बचती"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การตั้งค่าแคนวาสไม่เหลือภาพ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cài đặt khung vẽ không để lại ảnh nào"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengaturan kanvas tidak menyisakan gambar"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seting kanvas tidak meninggalkan imej"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuració del llenç no deixa cap imatge"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lærredsindstillingerne efterlader intet billede"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pohjan asetukset eivät jätä kuvaa"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De canvasinstellingen laten geen afbeelding over"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Arbetsytans inställningar lämnar ingen bild kvar"
          }
        }
      }
    },
    "The counter counts only the files that are converted.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zähler zählt nur die Dateien, die konvertiert werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compteur ne compte que les fichiers convertis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contador solo cuenta los archivos que se convierten."
