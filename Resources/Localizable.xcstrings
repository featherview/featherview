          "stringUnit": {
            "state": "translated",
            "value": "Zakończyć w trakcie przetwarzania wsadowego?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukončit, když dávka ještě běží?"
