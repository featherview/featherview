    "Files not converted yet are left as they are.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nicht konvertierte Dateien bleiben unverändert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers pas encore convertis restent tels quels."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos aún no convertidos quedan como están."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file non ancora convertiti restano come sono."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos ainda não convertidos ficam como estão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ещё не преобразованные файлы останутся без изменений."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ще не перетворені файли залишаться без змін."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pliki jeszcze nieprzekonwertowane pozostaną bez zmian."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosud nepřevedené soubory zůstanou beze změny."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα αρχεία που δεν έχουν μετατραπεί ακόμη μένουν ως έχουν."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الملفات التي لم تُحوَّل بعد تبقى كما هي."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קבצים שעוד לא הומרו נשארים כפי שהם."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz dönüştürülmemiş dosyalar olduğu gibi kalır."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A még nem konvertált fájlok változatlanok maradnak."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fișierele care nu au fost încă convertite rămân așa cum sunt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ変換されていないファイルはそのまま残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 변환되지 않은 파일은 그대로 남습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未转换的文件将保持原样。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未轉換的檔案會保持原樣。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जो फ़ाइलें अभी रूपांतरित नहीं हुई हैं, वे जैसी हैं वैसी रहेंगी।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์ที่ยังไม่ได้แปลงจะคงไว้ตามเดิม"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các tệp chưa được chuyển đổi sẽ được giữ nguyên."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File yang belum dikonversi dibiarkan apa adanya."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Fail yang belum ditukar dibiarkan seperti asal."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els fitxers que encara no s’han convertit es queden com estan."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Filer, der ikke er konverteret endnu, forbliver, som de er."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vielä muuntamattomat tiedostot jäävät ennalleen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestanden die nog niet zijn geconverteerd, blijven zoals ze zijn."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Filer som inte har konverterats än lämnas som de är."
          }
        }
      }
    },
