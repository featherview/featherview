    "Featherview can open your images instead of Preview. You can change this later in Preferences › Browsing.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Featherview kann deine Bilder statt Vorschau öffnen. Du kannst das später unter Einstellungen › Blättern ändern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Featherview peut ouvrir vos images à la place d’Aperçu. Vous pourrez changer cela plus tard dans Préférences › Navigation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Featherview puede abrir tus imágenes en lugar de Vista Previa. Puedes cambiarlo más tarde en Preferencias › Navegación."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Featherview può aprire le tue immagini al posto di Anteprima. Puoi cambiarlo in seguito in Preferenze › Navigazione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Featherview pode abrir suas imagens em vez do Pré-Visualização. Você pode mudar isso depois em Preferências › Navegação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Featherview может открывать ваши изображения вместо Просмотра. Это можно изменить позже в разделе Настройки › Навигация."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Featherview може відкривати ваші зображення замість Перегляду. Це можна змінити пізніше в Параметри › Навігація."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Featherview może otwierać Twoje obrazki zamiast Podglądu. Możesz to później zmienić w Ustawienia › Przeglądanie."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Featherview může otevírat vaše obrázky místo Náhledu. Později to můžete změnit v Nastavení › Procházení."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Featherview μπορεί να ανοίγει τις εικόνες σας αντί για την Προεπισκόπηση. Μπορείτε να το αλλάξετε αργότερα στις Ρυθμίσεις › Περιήγηση."
          }
        }
      }
    },
    "Featherview couldn't become the default for %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Featherview konnte nicht zum Standard für %@ werden."
