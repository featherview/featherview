    "An inner width of 0 draws one border.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit einer inneren Breite von 0 entsteht ein einzelner Rahmen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une largeur intérieure de 0 trace une seule bordure."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ancho interior de 0 dibuja un solo borde."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una larghezza interna di 0 disegna un solo bordo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma largura interna de 0 desenha uma só borda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При внутренней ширине 0 рисуется одна рамка."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За внутрішньої ширини 0 малюється одна рамка."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przy szerokości wewnętrznej 0 rysowana jest jedna ramka."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při vnitřní šířce 0 se kreslí jeden okraj."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Με εσωτερικό πλάτος 0 σχεδιάζεται ένα περίγραμμα."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عرض داخلي يساوي 0 يرسم إطارًا واحدًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רוחב פנימי 0 מצייר מסגרת אחת."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İç genişlik 0 ise tek kenarlık çizilir."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "0 belső szélesség egyetlen keretet rajzol."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O lățime interioară de 0 desenează o singură bordură."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内側の幅が 0 のときは枠を 1 本だけ描きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안쪽 너비가 0이면 테두리를 하나만 그립니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内侧宽度为 0 时只绘制一层边框。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "內側寬度為 0 時只繪製一層邊框。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भीतरी चौड़ाई 0 होने पर एक ही बॉर्डर बनता है।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ความกว้างด้านใน 0 จะวาดขอบเพียงเส้นเดียว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiều rộng bên trong bằng 0 sẽ vẽ một viền."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lebar dalam 0 menggambar satu bingkai."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lebar dalam 0 melukis satu sempadan."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Una amplada interior de 0 dibuixa una sola vora."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En indre bredde på 0 tegner én kant."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sisäleveys 0 piirtää yhden reunuksen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met een binnenbreedte van 0 wordt één rand getekend."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En inre bredd på 0 ritar en enda kant."
          }
        }
      }
    },
