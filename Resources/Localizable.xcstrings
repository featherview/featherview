    "After a move or Move to Trash": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach dem Bewegen oder Löschen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après un déplacement ou une mise à la corbeille"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras mover o trasladar a la papelera"
          }
        },
        "it": {
          "stringUnit": {
