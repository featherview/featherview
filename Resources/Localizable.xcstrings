    "Save As and the batch window start with these options for each format.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Speichern unter“ und das Stapelfenster beginnen mit diesen Optionen für jedes Format."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Enregistrer sous » et la fenêtre de traitement par lot partent de ces options pour chaque format."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardar como y la ventana de lotes empiezan con estas opciones para cada formato."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva come e la finestra batch partono da queste opzioni per ogni formato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvar Como e a janela de lote começam com estas opções para cada formato."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Сохранить как» и окно пакетной обработки начинают с этих параметров для каждого формата."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Зберегти як» і вікно пакетної обробки починають із цих параметрів для кожного формату."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachowaj jako i okno przetwarzania wsadowego zaczynają z tymi opcjami dla każdego formatu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uložit jako a okno dávky začínají s těmito volbami pro každý formát."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η «Αποθήκευση ως» και το παράθυρο μαζικής επεξεργασίας ξεκινούν με αυτές τις επιλογές για κάθε μορφή."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدأ «حفظ باسم» ونافذة الدفعة بهذه الخيارات لكل تنسيق."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "״שמור בשם״ וחלון האצווה מתחילים עם האפשרויות האלה לכל פורמט."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Farklı Kaydet ve toplu işlem penceresi her biçim için bu seçeneklerle başlar."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Mentés másként és a kötegelt ablak ezekkel a beállításokkal indul az egyes formátumokhoz."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvează ca și fereastra de lot pornesc cu aceste opțiuni pentru fiecare format."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“別名で保存”と一括処理ウインドウは、各フォーマットをこのオプションで開始します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'다른 이름으로 저장'과 일괄 처리 윈도우는 각 포맷을 이 옵션으로 시작합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“存储为”和批处理窗口会以这些选项作为各格式的初始设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「儲存為」和批次處理視窗會以這些選項作為各格式的初始設定。"
          }
        }
      }
    },
