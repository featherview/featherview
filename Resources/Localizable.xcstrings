    "Move, copy and trash sidecar files (.xmp, .aae, .thm) with their image": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Begleitdateien (.xmp, .aae, .thm) mit ihrem Bild bewegen, kopieren und löschen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacer, copier et supprimer les fichiers annexes (.xmp, .aae, .thm) avec leur image"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mover, copiar y eliminar los archivos asociados (.xmp, .aae, .thm) con su imagen"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sposta, copia ed elimina i file collaterali (.xmp, .aae, .thm) con la loro immagine"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mover, copiar e apagar arquivos auxiliares (.xmp, .aae, .thm) com sua imagem"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перемещать, копировать и удалять сопутствующие файлы (.xmp, .aae, .thm) вместе с изображением"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переміщати, копіювати й видаляти супутні файли (.xmp, .aae, .thm) разом із зображенням"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przenoś, kopiuj i usuwaj pliki towarzyszące (.xmp, .aae, .thm) razem z obrazkiem"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přesouvat, kopírovat a mazat doprovodné soubory (.xmp, .aae, .thm) spolu s obrázkem"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μετακίνηση, αντιγραφή και διαγραφή συνοδευτικών αρχείων (.xmp, .aae, .thm) μαζί με την εικόνα τους"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نقل الملفات المرافقة (.xmp و.aae و.thm) ونسخها وحذفها مع صورتها"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "העבר, העתק והשלך לפח קובצי לוואי (‎.xmp,‏ ‎.aae,‏ ‎.thm) יחד עם התמונה שלהם"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yardımcı dosyaları (.xmp, .aae, .thm) görüntüleriyle birlikte taşı, kopyala ve Çöp Sepetine at"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kísérőfájlok (.xmp, .aae, .thm) áthelyezése, másolása és Kukába helyezése a képükkel együtt"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mută, copiază și aruncă la coș fișierele însoțitoare (.xmp, .aae, .thm) împreună cu imaginea lor"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイドカーファイル（.xmp、.aae、.thm）も画像と一緒に移動、コピー、ゴミ箱へ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사이드카 파일(.xmp, .aae, .thm)을 이미지와 함께 이동, 복사 및 휴지통으로 이동"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "附属文件（.xmp、.aae、.thm）随图像一起移动、拷贝和移到废纸篓"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "附屬檔案（.xmp、.aae、.thm）隨影像一起搬移、拷貝和丟到垃圾桶"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साइडकार फ़ाइलें (.xmp, .aae, .thm) उनकी छवि के साथ ले जाएँ, कॉपी करें और ट्रैश में डालें"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ย้าย คัดลอก และทิ้งไฟล์ประกอบ (.xmp, .aae, .thm) ไปพร้อมกับภาพ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Di chuyển, sao chép và bỏ vào thùng rác các tệp đi kèm (.xmp, .aae, .thm) cùng ảnh của chúng"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindahkan, salin, dan buang file sidecar (.xmp, .aae, .thm) bersama gambarnya"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindah, salin dan buang fail sisian (.xmp, .aae, .thm) bersama imejnya"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mou, copia i llença els fitxers auxiliars (.xmp, .aae, .thm) amb la seva imatge"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flyt, kopier og kassér sidecar-filer (.xmp, .aae, .thm) sammen med billedet"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siirrä, kopioi ja poista sivutiedostot (.xmp, .aae, .thm) kuvan mukana"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verplaats, kopieer en verwijder sidecarbestanden (.xmp, .aae, .thm) samen met hun afbeelding"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flytta, kopiera och släng sidofiler (.xmp, .aae, .thm) tillsammans med bilden"
          }
        }
      }
    },
