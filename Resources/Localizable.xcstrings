          "stringUnit": {
            "state": "translated",
            "value": "Kohdetta %@ ei voitu asettaa työpöydän kuvaksi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de définir %@ comme fond d’écran"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לקבוע את %@ כתמונת שולחן העבודה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ को डेस्कटॉप चित्र के रूप में सेट नहीं किया जा सका"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nem állítható be íróasztalképként"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat mengatur %@ sebagai gambar desktop"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile impostare %@ come immagine scrivania"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ をデスクトップピクチャに設定できませんでした"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 데스크탑 사진으로 설정할 수 없습니다"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat menetapkan %@ sebagai gambar desktop"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan %@ niet instellen als bureaubladachtergrond"
          }
        },
        "pl": {
