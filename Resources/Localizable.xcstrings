            "value": "Γρήγορο πρόγραμμα προβολής εικόνων με χειρισμό από το πληκτρολόγιο"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عارض صور سريع يُدار بلوحة المفاتيح"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מציג תמונות מהיר שמופעל מהמקלדת"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hızlı, klavyeyle kullanılan görüntü izleyici"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Gyors, billentyűzettel vezérelt képnézegető"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vizualizator de imagini rapid, controlat din tastatură"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードで操作できる高速な画像ビューア"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드로 다루는 빠른 이미지 뷰어"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快速、以键盘操作的图像查看器"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "快速、以鍵盤操作的影像檢視器"
          }
        }
      }
    },
