    "Are you sure you want to change the extension from “.%@” to “.%@”?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل تريد بالتأكيد تغيير الامتداد من ”.%1$@“ إلى ”.%2$@“؟"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segur que vols canviar l’extensió de “.%1$@” a “.%2$@”?"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opravdu chcete změnit příponu z „.%1$@“ na „.%2$@“?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er du sikker på, at du vil ændre endelsen fra “.%1$@” til “.%2$@”?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Möchtest du die Endung wirklich von „.%1$@“ in „.%2$@“ ändern?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Θέλετε σίγουρα να αλλάξετε την επέκταση από «.%1$@» σε «.%2$@»;"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Seguro que quieres cambiar la extensión de “.%1$@” a “.%2$@”?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haluatko varmasti vaihtaa päätteen ”.%1$@” päätteeksi ”.%2$@”?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voulez-vous vraiment remplacer l’extension « .%1$@ » par « .%2$@ » ?"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "האם ברצונך לשנות את הסיומת מ־”.%1$@“ ל־”.%2$@“?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "क्या आप वाकई एक्सटेंशन “.%1$@” से “.%2$@” में बदलना चाहते हैं?"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biztosan módosítja a kiterjesztést „.%1$@” helyett „.%2$@” értékre?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yakin ingin mengubah ekstensi dari “.%1$@” menjadi “.%2$@”?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuoi davvero cambiare l’estensione da “.%1$@” a “.%2$@”?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拡張子を“.%1$@”から“.%2$@”に変更してもよろしいですか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "확장자를 ‘.%1$@’에서 ‘.%2$@’(으)로 변경하겠습니까?"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adakah anda pasti mahu menukar sambungan daripada “.%1$@” kepada “.%2$@”?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weet je zeker dat je de extensie wilt wijzigen van ‘.%1$@’ in ‘.%2$@’?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy na pewno zmienić rozszerzenie z „.%1$@” na „.%2$@”?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tem certeza de que deseja alterar a extensão de “.%1$@” para “.%2$@”?"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigur vrei să schimbi extensia din „.%1$@” în „.%2$@”?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
