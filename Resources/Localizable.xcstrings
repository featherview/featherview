    "Changes the converted files, not the originals.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يغيّر الملفات المحوّلة، لا الأصلية."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Canvia els fitxers convertits, no els originals."
          }
