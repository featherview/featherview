        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: με αυτές τις ρυθμίσεις πλακιδίων δεν μένει τίποτα από την εικόνα"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: إعدادات المربعات لا تُبقي شيئًا من الصورة"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: הגדרות האריחים לא משאירות דבר מהתמונה"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Döşeme ayarları görüntüden bir şey bırakmıyor"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: a csempék beállításai nem hagynak semmit a képből"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: configurările plăcilor nu lasă nimic din imagine"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：タイル設定によって画像が残りません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: 타일 설정 때문에 이미지가 남지 않습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：拼贴设置不会留下任何图像"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：拼貼設定不會留下任何影像"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: टाइल सेटिंग्ज़ से कोई छवि नहीं बचती"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: การตั้งค่าไทล์ไม่เหลือภาพ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: cài đặt ô không để lại ảnh nào"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: pengaturan ubin tidak menyisakan gambar"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: seting jubin tidak meninggalkan imej"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: la configuració de les rajoles no deixa cap imatge"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: fliseindstillingerne efterlader intet billede"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: ruutujen asetukset eivät jätä kuvaa"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: de tegelinstellingen laten geen afbeelding over"
          }
        },
        "sv": {
