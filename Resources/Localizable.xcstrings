    "Lossless flipping works with JPEG, HEIC and TIFF only": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlustfreies Spiegeln geht nur mit JPEG, HEIC und TIFF"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le retournement sans perte ne fonctionne qu’avec JPEG, HEIC et TIFF"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El volteo sin pérdida solo funciona con JPEG, HEIC y TIFF"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La riflessione senza perdita funziona solo con JPEG, HEIC e TIFF"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O espelhamento sem perda só funciona com JPEG, HEIC e TIFF"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отражение без потерь возможно только для JPEG, HEIC и TIFF"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Віддзеркалення без втрат можливе лише для JPEG, HEIC і TIFF"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odbicie bezstratne działa tylko z JPEG, HEIC i TIFF"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezeztrátové překlopení funguje jen s JPEG, HEIC a TIFF"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αναστροφή χωρίς απώλειες λειτουργεί μόνο με JPEG, HEIC και TIFF"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "القلب بلا فقدان يعمل مع JPEG وHEIC وTIFF فقط"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "היפוך ללא אובדן עובד עם JPEG,‏ HEIC ו־TIFF בלבד"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıpsız çevirme yalnızca JPEG, HEIC ve TIFF ile çalışır"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A veszteségmentes tükrözés csak JPEG, HEIC és TIFF formátummal működik"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Oglindirea fără pierderi funcționează doar cu JPEG, HEIC și TIFF"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "劣化なしの反転は JPEG、HEIC、TIFF のみに対応しています"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무손실 뒤집기는 JPEG, HEIC 및 TIFF에서만 가능합니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无损翻转仅适用于 JPEG、HEIC 和 TIFF"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無損翻轉僅適用於 JPEG、HEIC 和 TIFF"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लॉसलेस पलटना केवल JPEG, HEIC और TIFF के साथ काम करता है"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การพลิกแบบไม่สูญเสียคุณภาพใช้ได้กับ JPEG, HEIC และ TIFF เท่านั้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lật không mất dữ liệu chỉ hoạt động với JPEG, HEIC và TIFF"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembalikan lossless hanya berfungsi dengan JPEG, HEIC, dan TIFF"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembalikan tanpa kehilangan hanya berfungsi dengan JPEG, HEIC dan TIFF"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El capgirament sense pèrdua només funciona amb JPEG, HEIC i TIFF"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabsfri spejlvending virker kun med JPEG, HEIC og TIFF"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Häviötön peilaus toimii vain JPEG-, HEIC- ja TIFF-kuvilla"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verliesvrij spiegelen werkt alleen met JPEG, HEIC en TIFF"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förlustfri spegelvändning fungerar bara med JPEG, HEIC och TIFF"
          }
        }
      }
    },
