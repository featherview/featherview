    "For any other type, open an image of it and choose File › Always Open with Featherview." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لأي نوع آخر، افتح صورة منه واختر ملف › الفتح دائمًا باستخدام Featherview."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per a qualsevol altre tipus, obre’n una imatge i tria Arxiu › Obre sempre amb el Featherview."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro jakýkoli jiný typ otevřete obrázek tohoto typu a zvolte Soubor › Vždy otevírat ve Featherview."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For alle andre typer skal du åbne et billede af typen og vælge Arkiv › Åbn altid med Featherview."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für jeden anderen Typ öffne ein Bild davon und wähle Ablage › Immer mit Featherview öffnen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Για οποιονδήποτε άλλο τύπο, ανοίξτε μια εικόνα του και επιλέξτε Αρχείο › Πάντα άνοιγμα με το Featherview."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para cualquier otro tipo, abre una imagen de ese tipo y elige Archivo › Abrir siempre con Featherview."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muille tyypeille avaa sen tyyppinen kuva ja valitse Arkisto › Avaa aina Featherview-apilla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour tout autre type, ouvrez une image de ce type et choisissez Fichier › Toujours ouvrir avec Featherview."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עבור כל סוג אחר, פתח תמונה מסוג זה ובחר קובץ › פתח תמיד באמצעות Featherview."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी भी अन्य प्रकार के लिए, उस प्रकार की कोई छवि खोलें और फ़ाइल › हमेशा Featherview से खोलें चुनें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bármely más típushoz nyisson meg egy ilyen képet, és válassza a Fájl › Megnyitás mindig a Featherview-val parancsot."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk jenis lain, buka gambar dari jenis tersebut lalu pilih File › Selalu Buka dengan Featherview."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per qualsiasi altro tipo, apri un’immagine di quel tipo e scegli File › Apri sempre con Featherview."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ほかの種類は、その種類の画像を開いて“ファイル › 常に Featherview で開く”を選択します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 유형은 해당 유형의 이미지를 열고 파일 › 항상 Featherview로 열기를 선택하십시오."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk jenis lain, buka imej jenis itu dan pilih Fail › Sentiasa Buka dengan Featherview."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voor elk ander type open je een afbeelding van dat type en kies je Archief › Altijd openen met Featherview."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W przypadku innego typu otwórz obrazek tego typu i wybierz Plik › Zawsze otwieraj w Featherview."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para qualquer outro tipo, abra uma imagem desse tipo e escolha Arquivo › Sempre Abrir com o Featherview."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pentru orice alt tip, deschide o imagine de acel tip și alege Fișier › Deschide întotdeauna cu Featherview."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для любого другого типа откройте изображение этого типа и выберите Файл › Всегда открывать в Featherview."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För alla andra typer öppnar du en bild av den typen och väljer Arkiv › Öppna alltid med Featherview."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สำหรับประเภทอื่น ให้เปิดภาพประเภทนั้นแล้วเลือก ไฟล์ › เปิดด้วย Featherview เสมอ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başka bir tür için o türde bir görüntü açın ve Dosya › Her Zaman Featherview ile Aç’ı seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для будь-якого іншого типу відкрийте зображення цього типу й виберіть Файл › Завжди відкривати у Featherview."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Với loại khác, hãy mở một ảnh thuộc loại đó và chọn Tệp › Luôn mở bằng Featherview."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对于其他类型，请打开该类型的图像，然后选取“文件 › 始终用 Featherview 打开”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若是其他類型，請打開該類型的影像，然後選擇「檔案 › 一律使用 Featherview 打開」。"
          }
        }
      }
    },
