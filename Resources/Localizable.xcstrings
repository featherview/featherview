    "Featherview can open your images instead of Preview. You can change this later in Preferences › Browsing.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Featherview kann deine Bilder statt Vorschau öffnen. Du kannst das später unter Einstellungen › Blättern ändern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Featherview peut ouvrir vos images à la place d’Aperçu. Vous pourrez changer cela plus tard dans Préférences › Navigation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Featherview puede abrir tus imágenes en lugar de Vista Previa. Puedes cambiarlo más tarde en Preferencias › Navegación."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Featherview può aprire le tue immagini al posto di Anteprima. Puoi cambiarlo in seguito in Preferenze › Navigazione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Featherview pode abrir suas imagens em vez do Pré-Visualização. Você pode mudar isso depois em Preferências › Navegação."
          }
        }
      }
    },
    "Featherview couldn't become the default for %@.": {
