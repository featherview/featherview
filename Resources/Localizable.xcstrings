        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar pagina 1 din %@ poate fi rotită fără pierderi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”で劣化なしに回転できるのは 1 ページ目だけです"
