    "Can't check for updates right now.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerade kann nicht nach Updates gesucht werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de rechercher les mises à jour pour le moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora no se pueden buscar actualizaciones."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al momento non è possibile cercare aggiornamenti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível procurar atualizações agora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас не удаётся проверить обновления."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зараз не вдається перевірити оновлення."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można teraz sprawdzić aktualizacji."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualizace teď nelze zkontrolovat."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν είναι δυνατός ο έλεγχος για ενημερώσεις αυτή τη στιγμή."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتعذّر التحقق من التحديثات الآن."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לבדוק עדכונים כרגע."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu anda güncellemeler denetlenemiyor."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Most nem lehet frissítéseket keresni."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Momentan nu se pot căuta actualizări."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、アップデートを確認できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 업데이트를 확인할 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前无法检查更新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前無法檢查更新項目。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी अपडेट की जाँच नहीं हो सकती।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถตรวจหาอัปเดตได้ในขณะนี้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện không thể kiểm tra bản cập nhật."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat memeriksa pembaruan saat ini."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat menyemak kemas kini sekarang."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ara no es poden cercar actualitzacions."
          }
        },
        "da": {
