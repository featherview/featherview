    "Lossless rotation works with JPEG, HEIC and TIFF only": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlustfreies Drehen geht nur mit JPEG, HEIC und TIFF"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La rotation sans perte ne fonctionne qu’avec JPEG, HEIC et TIFF"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El giro sin pérdida solo funciona con JPEG, HEIC y TIFF"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La rotazione senza perdita funziona solo con JPEG, HEIC e TIFF"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A rotação sem perda só funciona com JPEG, HEIC e TIFF"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поворот без потерь возможен только для JPEG, HEIC и TIFF"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поворот без втрат можливий лише для JPEG, HEIC і TIFF"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrót bezstratny działa tylko z JPEG, HEIC i TIFF"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezeztrátové otočení funguje jen s JPEG, HEIC a TIFF"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η περιστροφή χωρίς απώλειες λειτουργεί μόνο με JPEG, HEIC και TIFF"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التدوير بلا فقدان يعمل مع JPEG وHEIC وTIFF فقط"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סיבוב ללא אובדן עובד עם JPEG,‏ HEIC ו־TIFF בלבד"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıpsız döndürme yalnızca JPEG, HEIC ve TIFF ile çalışır"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A veszteségmentes forgatás csak JPEG, HEIC és TIFF formátummal működik"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Rotirea fără pierderi funcționează doar cu JPEG, HEIC și TIFF"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "劣化なしの回転は JPEG、HEIC、TIFF のみに対応しています"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무손실 회전은 JPEG, HEIC 및 TIFF에서만 가능합니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无损旋转仅适用于 JPEG、HEIC 和 TIFF"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無損旋轉僅適用於 JPEG、HEIC 和 TIFF"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लॉसलेस घुमाव केवल JPEG, HEIC और TIFF के साथ काम करता है"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การหมุนแบบไม่สูญเสียคุณภาพใช้ได้กับ JPEG, HEIC และ TIFF เท่านั้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xoay không mất dữ liệu chỉ hoạt động với JPEG, HEIC và TIFF"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rotasi lossless hanya berfungsi dengan JPEG, HEIC, dan TIFF"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Putaran tanpa kehilangan hanya berfungsi dengan JPEG, HEIC dan TIFF"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La rotació sense pèrdua només funciona amb JPEG, HEIC i TIFF"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabsfri rotation virker kun med JPEG, HEIC og TIFF"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Häviötön kääntö toimii vain JPEG-, HEIC- ja TIFF-kuvilla"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verliesvrij roteren werkt alleen met JPEG, HEIC en TIFF"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förlustfri rotering fungerar bara med JPEG, HEIC och TIFF"
          }
        }
