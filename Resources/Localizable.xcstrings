        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Salir mientras se procesa el lote?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uscire mentre il batch è in corso?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encerrar com o lote em andamento?"
          }
        },
        "ru": {
