    "Couldn't set %@ as the desktop picture": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر تعيين %@ كصورة سطح المكتب"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s’ha pogut definir %@ com a imatge de l’escriptori"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nelze nastavit jako obrázek plochy"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kunne ikke bruges som skrivebordsbillede"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ konnte nicht als Schreibtischhintergrund festgelegt werden"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατός ο ορισμός του %@ ως εικόνας γραφείου"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido usar %@ como fondo de escritorio"
          }
        },
