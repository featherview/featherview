    "Featherview can open your images instead of Preview. You can change this later in Preferences › Browsing.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Featherview kann deine Bilder statt Vorschau öffnen. Du kannst das später unter Einstellungen › Blättern ändern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Featherview peut ouvrir vos images à la place d’Aperçu. Vous pourrez changer cela plus tard dans Préférences › Navigation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Featherview puede abrir tus imágenes en lugar de Vista Previa. Puedes cambiarlo más tarde en Preferencias › Navegación."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Featherview può aprire le tue immagini al posto di Anteprima. Puoi cambiarlo in seguito in Preferenze › Navigazione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Featherview pode abrir suas imagens em vez do Pré-Visualização. Você pode mudar isso depois em Preferências › Navegação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Featherview может открывать ваши изображения вместо Просмотра. Это можно изменить позже в разделе Настройки › Навигация."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Featherview може відкривати ваші зображення замість Перегляду. Це можна змінити пізніше в Параметри › Навігація."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Featherview może otwierać Twoje obrazki zamiast Podglądu. Możesz to później zmienić w Ustawienia › Przeglądanie."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Featherview může otevírat vaše obrázky místo Náhledu. Později to můžete změnit v Nastavení › Procházení."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Featherview μπορεί να ανοίγει τις εικόνες σας αντί για την Προεπισκόπηση. Μπορείτε να το αλλάξετε αργότερα στις Ρυθμίσεις › Περιήγηση."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن لـ Featherview فتح صورك بدلًا من «معاينة». يمكنك تغيير ذلك لاحقًا في التفضيلات › التصفح."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Featherview יכול לפתוח את התמונות שלך במקום ״תצוגה מקדימה״. ניתן לשנות זאת מאוחר יותר בהעדפות › דפדוף."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Featherview görüntülerinizi Önizleme yerine açabilir. Bunu daha sonra Tercihler › Göz Atma bölümünden değiştirebilirsiniz."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Featherview az Előnézet helyett is megnyithatja a képeit. Ezt később a Beállítások › Böngészés részen módosíthatja."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Featherview îți poate deschide imaginile în locul aplicației Previzualizare. Poți schimba asta mai târziu în Preferințe › Navigare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレビューの代わりに Featherview で画像を開けます。この設定はあとから“環境設定 › ブラウズ”で変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미리보기 대신 Featherview로 이미지를 열 수 있습니다. 나중에 환경설정 › 탐색에서 변경할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Featherview 可以代替“预览”打开你的图像。你以后可以在“偏好设置 › 浏览”中更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Featherview 可以取代「預覽程式」打開你的影像。你之後可以在「偏好設定 › 瀏覽」中更改。"
          }
        }
      }
    },
    "Featherview couldn't become the default for %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Featherview konnte nicht zum Standard für %@ werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Featherview n’a pas pu devenir l’app par défaut pour %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Featherview no ha podido ser la app predeterminada para %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Featherview non è potuto diventare l’app predefinita per %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Featherview não pôde se tornar o padrão para %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Featherview не удалось назначить программой по умолчанию для %@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося призначити Featherview програмою за замовчуванням для %@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się ustawić Featherview jako domyślnej aplikacji dla %@."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Featherview se nepodařilo nastavit jako výchozí pro %@."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατό να οριστεί το Featherview ως προεπιλογή για %@."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر جعل Featherview التطبيق الافتراضي لـ %@."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Featherview לא הצליח להפוך לברירת המחדל עבור %@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Featherview, %@ için varsayılan uygulama yapılamadı."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Featherview nem lett alapértelmezett ehhez: %@."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Featherview nu a putut deveni aplicația implicită pentru %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Featherview を %@ のデフォルトにできませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Featherview를 %@의 기본 앱으로 설정하지 못했습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Featherview 未能成为 %@ 的默认应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Featherview 無法成為 %@ 的預設 App。"
          }
        }
      }
    },
