    "Save As and the batch window start with these options for each format.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Speichern unter“ und das Stapelfenster beginnen mit diesen Optionen für jedes Format."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Enregistrer sous » et la fenêtre de traitement par lot partent de ces options pour chaque format."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardar como y la ventana de lotes empiezan con estas opciones para cada formato."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva come e la finestra batch partono da queste opzioni per ogni formato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvar Como e a janela de lote começam com estas opções para cada formato."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Сохранить как» и окно пакетной обработки начинают с этих параметров для каждого формата."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Зберегти як» і вікно пакетної обробки починають із цих параметрів для кожного формату."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachowaj jako i okno przetwarzania wsadowego zaczynają z tymi opcjami dla każdego formatu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uložit jako a okno dávky začínají s těmito volbami pro každý formát."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η «Αποθήκευση ως» και το παράθυρο μαζικής επεξεργασίας ξεκινούν με αυτές τις επιλογές για κάθε μορφή."
          }
        }
      }
    },
