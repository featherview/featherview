    "Click to copy the version, macOS version and Mac model": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicken, um Version, macOS-Version und Mac-Modell zu kopieren"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquer pour copier la version, la version de macOS et le modèle de Mac"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic para copiar la versión, la versión de macOS y el modelo de Mac"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic per copiare la versione, la versione di macOS e il modello di Mac"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique para copiar a versão, a versão do macOS e o modelo do Mac"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите, чтобы скопировать версию, версию macOS и модель Mac"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Клацніть, щоб скопіювати версію, версію macOS і модель Mac"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij, aby skopiować wersję, wersję macOS i model Maca"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klikněte pro zkopírování verze, verze macOS a modelu Macu"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάντε κλικ για αντιγραφή της έκδοσης, της έκδοσης macOS και του μοντέλου Mac"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر لنسخ الإصدار وإصدار macOS وطراز Mac"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לחץ כדי להעתיק את הגרסה, גרסת macOS ודגם ה־Mac"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sürümü, macOS sürümünü ve Mac modelini kopyalamak için tıklayın"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kattintson a verzió, a macOS verzió és a Mac típusának másolásához"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fă clic pentru a copia versiunea, versiunea macOS și modelul de Mac"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリックするとバージョン、macOS のバージョン、Mac の機種をコピーします"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클릭하여 버전, macOS 버전 및 Mac 모델 복사"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按以拷贝版本、macOS 版本和 Mac 机型"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按一下來拷貝版本、macOS 版本和 Mac 機型"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संस्करण, macOS संस्करण और Mac मॉडल कॉपी करने के लिए क्लिक करें"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คลิกเพื่อคัดลอกเวอร์ชัน เวอร์ชัน macOS และรุ่น Mac"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bấm để sao chép phiên bản, phiên bản macOS và kiểu máy Mac"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik untuk menyalin versi, versi macOS, dan model Mac"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik untuk menyalin versi, versi macOS dan model Mac"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Fes clic per copiar la versió, la versió del macOS i el model de Mac"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik for at kopiere versionen, macOS-versionen og Mac-modellen"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopioi versio, macOS-versio ja Mac-malli osoittamalla"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
