    "Move, copy and trash sidecar files (.xmp, .aae, .thm) with their image": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نقل الملفات المرافقة (.xmp و.aae و.thm) ونسخها وحذفها مع صورتها"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "העבר, העתק והשלך לפח קובצי לוואי (‎.xmp,‏ ‎.aae,‏ ‎.thm) יחד עם התמונה שלהם"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yardımcı dosyaları (.xmp, .aae, .thm) görüntüleriyle birlikte taşı, kopyala ve Çöp Sepetine at"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kísérőfájlok (.xmp, .aae, .thm) áthelyezése, másolása és Kukába helyezése a képükkel együtt"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mută, copiază și aruncă la coș fișierele însoțitoare (.xmp, .aae, .thm) împreună cu imaginea lor"
          }
        }
      }
    },
