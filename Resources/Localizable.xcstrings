            "state": "translated",
            "value": "Featherview-appia ei voitu asettaa oletukseksi kohteelle %@."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El Featherview no s’ha pogut convertir en l’app per omissió per a %@."
          }
        }
      }
    },
