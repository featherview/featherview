        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן לסובב ללא אובדן רק את עמוד 1 של %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ dosyasının yalnızca 1. sayfası kayıpsız döndürülebilir"
