        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ערך גבוה יותר איטי יותר ויוצר קבצים קטנים יותר"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha yüksek değer daha yavaştır ve daha küçük dosyalar üretir"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A magasabb érték lassabb, és kisebb fájlokat készít"
