            "value": "Без потерь можно отразить только страницу 1 из %@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Без втрат можна віддзеркалити лише сторінку 1 з %@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezstratnie można odbić tylko stronę 1 z %@"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezeztrátově lze překlopit jen stránku 1 z %@"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μόνο η σελίδα 1 του %@ μπορεί να αναστραφεί χωρίς απώλειες"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن قلب الصفحة 1 فقط من %@ بلا فقدان"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן להפוך ללא אובדן רק את עמוד 1 של %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ dosyasının yalnızca 1. sayfası kayıpsız çevrilebilir"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) %@ fájlnak csak az 1. oldala tükrözhető veszteségmentesen"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar pagina 1 din %@ poate fi oglindită fără pierderi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”で劣化なしに反転できるのは 1 ページ目だけです"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@'은(는) 첫 페이지만 무손실로 뒤집을 수 있습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”仅第 1 页可以无损翻转"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」只有第 1 頁可以無損翻轉"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ का केवल पृष्ठ 1 लॉसलेस पलटा जा सकता है"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พลิกแบบไม่สูญเสียคุณภาพได้เฉพาะหน้า 1 ของ %@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ có thể lật không mất dữ liệu trang 1 của %@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya halaman 1 dari %@ yang dapat dibalik tanpa kehilangan kualitas"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya halaman 1 daripada %@ boleh dibalikkan tanpa kehilangan"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Només la pàgina 1 de %@ es pot capgirar sense pèrdua"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun side 1 af %@ kan spejlvendes tabsfrit"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain tiedoston %@ sivun 1 voi peilata häviöttömästi"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen pagina 1 van %@ kan verliesvrij worden gespiegeld"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara sida 1 av %@ kan spegelvändas förlustfritt"
          }
        }
      }
