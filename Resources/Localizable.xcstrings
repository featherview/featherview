    "Save As and the batch window start with these options for each format.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“इस रूप में सहेजें” और बैच विंडो हर फ़ॉर्मैट के लिए इन्हीं विकल्पों से शुरू होते हैं।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "“บันทึกเป็น” และหน้าต่างแบตช์จะเริ่มด้วยตัวเลือกเหล่านี้สำหรับแต่ละรูปแบบ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "“Lưu thành” và cửa sổ hàng loạt bắt đầu với các tùy chọn này cho từng định dạng."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan Sebagai dan jendela batch dimulai dengan pilihan ini untuk setiap format."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan Sebagai dan tetingkap kelompok bermula dengan pilihan ini bagi setiap format."
          }
        }
      }
    },
