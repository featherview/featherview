    "The canvas settings leave no image": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Leinwand-Einstellungen lassen kein Bild übrig"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réglages du canevas ne laissent aucune image"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ajustes del lienzo no dejan imagen"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le impostazioni della tela non lasciano alcuna immagine"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os ajustes da tela não deixam imagem"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При этих настройках холста от изображения ничего не остаётся"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За цих налаштувань полотна від зображення нічого не лишається"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przy tych ustawieniach płótna z obrazka nic nie zostaje"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při tomto nastavení plátna z obrázku nic nezbude"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Με αυτές τις ρυθμίσεις καμβά δεν μένει τίποτα από την εικόνα"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعدادات اللوحة لا تُبقي شيئًا من الصورة"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגדרות המשטח לא משאירות דבר מהתמונה"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuval ayarları görüntüden bir şey bırakmıyor"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A vászon beállításai nem hagynak semmit a képből"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurările pânzei nu lasă nimic din imagine"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンバス設定によって画像がすべて切り取られます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캔버스 설정 때문에 이미지가 모두 잘립니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "画布设置会裁掉整张图像"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "畫布設定會裁掉整張影像"
          }
        }
      }
    },
    "The counter counts only the files that are converted.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zähler zählt nur die Dateien, die konvertiert werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compteur ne compte que les fichiers convertis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contador solo cuenta los archivos que se convierten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il contatore conta solo i file convertiti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O contador conta só os arquivos convertidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Счётчик учитывает только преобразованные файлы."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лічильник враховує лише перетворені файли."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Licznik liczy tylko przekonwertowane pliki."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Počítadlo počítá jen převedené soubory."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο μετρητής μετρά μόνο τα αρχεία που μετατρέπονται."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العدّاد يحسب الملفات المحوّلة فقط."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המונה סופר רק את הקבצים שמומרים."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayaç yalnızca dönüştürülen dosyaları sayar."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A számláló csak a konvertált fájlokat számolja."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Contorul numără doar fișierele convertite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カウンタは変換されたファイルだけを数えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카운터는 변환된 파일만 셉니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
