    "Only page 1 of %@ can be rotated losslessly": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Seite 1 von %@ lässt sich verlustfrei drehen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seule la page 1 de %@ peut pivoter sans perte"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo la página 1 de %@ se puede girar sin pérdida"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo la pagina 1 di %@ può essere ruotata senza perdita"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só a página 1 de %@ pode ser girada sem perda"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без потерь можно повернуть только страницу 1 из %@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Без втрат можна повернути лише сторінку 1 з %@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezstratnie można obrócić tylko stronę 1 z %@"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezeztrátově lze otočit jen stránku 1 z %@"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μόνο η σελίδα 1 του %@ μπορεί να περιστραφεί χωρίς απώλειες"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن تدوير الصفحة 1 فقط من %@ بلا فقدان"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן לסובב ללא אובדן רק את עמוד 1 של %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ dosyasının yalnızca 1. sayfası kayıpsız döndürülebilir"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) %@ fájlnak csak az 1. oldala forgatható veszteségmentesen"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar pagina 1 din %@ poate fi rotită fără pierderi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”で劣化なしに回転できるのは 1 ページ目だけです"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@'은(는) 첫 페이지만 무손실로 회전할 수 있습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”仅第 1 页可以无损旋转"
