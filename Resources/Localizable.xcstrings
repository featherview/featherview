    "Move, copy and trash sidecar files (.xmp, .aae, .thm) with their image": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Begleitdateien (.xmp, .aae, .thm) mit ihrem Bild bewegen, kopieren und löschen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacer, copier et supprimer les fichiers annexes (.xmp, .aae, .thm) avec leur image"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mover, copiar y eliminar los archivos asociados (.xmp, .aae, .thm) con su imagen"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sposta, copia ed elimina i file collaterali (.xmp, .aae, .thm) con la loro immagine"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mover, copiar e apagar arquivos auxiliares (.xmp, .aae, .thm) com sua imagem"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перемещать, копировать и удалять сопутствующие файлы (.xmp, .aae, .thm) вместе с изображением"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переміщати, копіювати й видаляти супутні файли (.xmp, .aae, .thm) разом із зображенням"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przenoś, kopiuj i usuwaj pliki towarzyszące (.xmp, .aae, .thm) razem z obrazkiem"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přesouvat, kopírovat a mazat doprovodné soubory (.xmp, .aae, .thm) spolu s obrázkem"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μετακίνηση, αντιγραφή και διαγραφή συνοδευτικών αρχείων (.xmp, .aae, .thm) μαζί με την εικόνα τους"
          }
        }
      }
    },
