    "Higher is slower and makes smaller files" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "القيمة الأعلى أبطأ وتنتج ملفات أصغر"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Més alt és més lent i fa fitxers més petits"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyšší je pomalejší a dává menší soubory"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Højere er langsommere og giver mindre filer"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Höher ist langsamer und erzeugt kleinere Dateien"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Υψηλότερη τιμή: πιο αργά και μικρότερα αρχεία"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Más alto es más lento y crea archivos más pequeños"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suurempi on hitaampi ja tekee pienempiä tiedostoja"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus élevé, c’est plus lent et les fichiers sont plus petits"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ערך גבוה יותר איטי יותר ויוצר קבצים קטנים יותר"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अधिक होने पर धीमा, पर फ़ाइलें छोटी"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A magasabb érték lassabb, és kisebb fájlokat készít"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lebih tinggi lebih lambat, file lebih kecil"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Più alto è più lento e crea file più piccoli"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高いほど遅くなり、ファイルは小さくなります"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "높을수록 느리지만 파일이 작아집니다"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lebih tinggi lebih perlahan, fail lebih kecil"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoger is trager en geeft kleinere bestanden"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyżej to wolniej, ale mniejsze pliki"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mais alto é mais lento e gera arquivos menores"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O valoare mai mare e mai lentă și produce fișiere mai mici"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чем выше, тем медленнее и тем меньше файлы"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Högre är långsammare och ger mindre filer"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ค่าสูงจะช้ากว่าแต่ได้ไฟล์เล็กกว่า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daha yüksek değer daha yavaştır ve daha küçük dosyalar üretir"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Що вище, то повільніше і менші файли"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Càng cao càng chậm nhưng tệp càng nhỏ"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "越高越慢，文件越小"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "越高越慢，檔案越小"
          }
        }
