            "value": "После перемещения или удаления в Корзину"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Після переміщення або переміщення в Смітник"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po przeniesieniu lub przeniesieniu do Kosza"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Po přesunutí nebo přesunutí do koše"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μετά από μετακίνηση ή μετακίνηση στον Κάδο"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد النقل أو النقل إلى سلة المهملات"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אחרי העברה או העברה לפח"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taşıma ya da Çöp Sepetine Taşıma sonrasında"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Áthelyezés vagy Kukába helyezés után"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "După o mutare sau o mutare în coș"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "移動またはゴミ箱に入れた後"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이동하거나 휴지통으로 이동한 후"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移动或移到废纸篓之后"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "搬移或丟到垃圾桶之後"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ले जाने या ट्रैश में ले जाने के बाद"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หลังจากย้ายหรือย้ายไปที่ถังขยะ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sau khi di chuyển hoặc chuyển vào Thùng rác"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setelah memindahkan atau Pindahkan ke Tong Sampah"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Selepas memindah atau Pindah ke Tong Sampah"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Després de moure o traslladar a la paperera"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Efter Flyt eller Flyt til papirkurv"
          }
        },
        "fi": {
          "stringUnit": {
