            "value": "Featherview"
          }
        }
      }
    },
    "Featherview can open your images instead of Preview. You can change this later in Preferences › Browsing.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن لـ Featherview فتح صورك بدلًا من «معاينة». يمكنك تغيير ذلك لاحقًا في التفضيلات › التصفح."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Featherview יכול לפתוח את התמונות שלך במקום ״תצוגה מקדימה״. ניתן לשנות זאת מאוחר יותר בהעדפות › דפדוף."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Featherview görüntülerinizi Önizleme yerine açabilir. Bunu daha sonra Tercihler › Göz Atma bölümünden değiştirebilirsiniz."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Featherview az Előnézet helyett is megnyithatja a képeit. Ezt később a Beállítások › Böngészés részen módosíthatja."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Featherview îți poate deschide imaginile în locul aplicației Previzualizare. Poți schimba asta mai târziu în Preferințe › Navigare."
          }
        }
      }
    },
    "Featherview couldn't become the default for %@.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر جعل Featherview التطبيق الافتراضي لـ %@."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Featherview לא הצליח להפוך לברירת המחדל עבור %@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Featherview, %@ için varsayılan uygulama yapılamadı."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Featherview nem lett alapértelmezett ehhez: %@."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Featherview nu a putut deveni aplicația implicită pentru %@."
          }
        }
      }
    },
