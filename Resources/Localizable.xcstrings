        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перемещать оригиналы в Корзину после преобразования"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переміщати оригінали в Смітник після перетворення"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przenoś oryginały do Kosza po konwersji"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Po převodu přesunout originály do koše"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μετακίνηση πρωτοτύπων στον Κάδο μετά τη μετατροπή"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نقل الأصول إلى سلة المهملات بعد التحويل"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "העבר את המקורות לפח אחרי ההמרה"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dönüştürdükten sonra orijinalleri Çöp Sepetine taşı"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Eredetik Kukába helyezése konvertálás után"
