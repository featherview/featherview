    "Featherview can open your images instead of Preview. You can change this later in Preferences › Browsing.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Featherview, Preview की जगह आपकी छवियाँ खोल सकता है। आप इसे बाद में प्राथमिकताएँ › ब्राउज़िंग में बदल सकते हैं।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Featherview สามารถเปิดภาพของคุณแทนแอปแสดงตัวอย่างได้ คุณเปลี่ยนได้ภายหลังในการตั้งค่า › การเรียกดู"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Featherview có thể mở ảnh của bạn thay cho Xem trước. Bạn có thể thay đổi điều này sau trong Tùy chọn › Duyệt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Featherview dapat membuka gambar Anda sebagai pengganti Pratinjau. Anda dapat mengubahnya nanti di Preferensi › Penjelajahan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Featherview boleh membuka imej anda dan bukannya Pratonton. Anda boleh mengubahnya kemudian dalam Keutamaan › Penyemakan."
          }
        }
      }
    },
    "Featherview couldn't become the default for %@.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Featherview %@ के लिए डिफ़ॉल्ट नहीं बन सका।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Featherview ไม่สามารถเป็นแอปเริ่มต้นสำหรับ %@ ได้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Featherview không thể trở thành mặc định cho %@."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Featherview tidak dapat menjadi default untuk %@."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Featherview tidak dapat menjadi lalai untuk %@."
          }
        }
      }
    },
